{
  "name": "@yeisme/dsh-semantic-file-editor",
  "version": "0.1.0-rc.1",
  "description": "Installable DSH semantic file editor host and Monaco asset bundle",
  "main": "lib/index.mjs",
  "scripts": {
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && tsdown src/index.ts --out-dir lib --format esm --dts --clean",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "generate:assets": "node scripts/generate-package-assets.mjs"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@yeisme/dsh-file-host": "workspace:*",
    "@yeisme/dsh-language-intelligence-host": "workspace:*",
    "monaco-editor": "0.56.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
