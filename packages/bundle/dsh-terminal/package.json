{
  "name": "@yeisme/dsh-terminal",
  "version": "0.1.0-rc.1",
  "description": "DSH Web terminal bundle: terminalPane Remote over official ctx.terminals + pane console view (xterm path stays duplex-seam gated)",
  "main": "lib/index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && tsdown"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeisme/harness-plugins.git",
    "directory": "packages/bundle/dsh-terminal"
  },
  "files": [
    "lib/index.js",
    "lib/module.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    null,
    "lib/host.js"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./module": "./lib/module.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./host": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/host.js"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@yeisme/dsh-client-ui-surface": "workspace:^",
    "@yeisme/dsh-terminal-host": "workspace:*",
    "@yeisme/dsh-workbench-core": "workspace:*",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.1",
    "jsdom": "^30.0.1",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "bundle": "pnpm --filter @yeisme/dsh-terminal-host build && tsc -p tsconfig.json && tsdown",
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  }
}
