{
  "name": "@yeisme/dsh-terminal",
  "version": "0.1.0-rc.1",
  "description": "DSH Pane Workbench terminal view backed by xterm.js and an owner-authorized terminal attachment",
  "main": "lib/index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && tsdown"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeisme/harness-plugins.git",
    "directory": "packages/bundle/dsh-terminal"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./module": "./lib/module.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@yeisme/dsh-terminal-host": "workspace:*",
    "@yeisme/dsh-workbench-core": "workspace:*",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.31",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
