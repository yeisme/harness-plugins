  "dependencies": { "@yeisme/dsh-template-registry": "workspace:*", "@yeisme/dsh-client-ui-template-registry": "workspace:*" },
  "devDependencies": { "typescript": "^5.9.3", "tsdown": "^0.22.14" }
}
