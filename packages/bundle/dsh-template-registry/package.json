{
  "name": "@yeisme/dsh-template-registry-bundle", "version": "0.1.0", "type": "module", "main": "lib/index.js",
  "scripts": { "build": "tsc -p tsconfig.json && tsdown", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "pnpm run build" },
