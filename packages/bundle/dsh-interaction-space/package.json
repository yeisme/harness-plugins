{
  "name": "@yeisme/dsh-interaction-space",
  "version": "0.1.0-rc.1",
  "description": "DSH Web artifact interaction space bundle: anchor bar, attached agent session, typed space directives, per-format proposals with preview-before-mutate",
  "main": "lib/index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm --filter @yeisme/dsh-client-ui-interaction-space build && tsc -p tsconfig.json && tsdown",
    "bundle": "pnpm --filter @yeisme/dsh-client-ui-interaction-space build && tsc -p tsconfig.json && tsdown"
  },
  "license": "MIT",
  "type": "module",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeisme/harness-plugins.git",
    "directory": "packages/bundle/dsh-interaction-space"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@yeisme/dsh-client-ui-interaction-space": "workspace:*",
    "@yeisme/dsh-selection-host": "workspace:*",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@types/react": "~18.3.31",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
