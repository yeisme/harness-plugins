{
  "name": "@yeisme/dsh-client-ui-semantic-file-editor",
  "version": "0.1.0-rc.1",
  "description": "Format-aware semantic file editor for DSH desktop.file panes",
  "main": "lib/index.mjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && tsdown src/index.tsx src/client.ts --out-dir lib --format esm --dts --clean"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/client.d.mts",
      "default": "./lib/client.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.7 <0.2.0",
    "@yeisme/dsh-client-ui-surface": "workspace:*",
    "@yeisme/dsh-file-document": "workspace:*",
    "@yeisme/dsh-file-host": "workspace:*",
    "@yeisme/dsh-language-intelligence-host": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.7 <0.2.0",
    "@yeisme/dsh-client-ui-surface": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": false
    }
  }
}
