{
  "name": "@yeisme/dsh-client-ui-template-registry",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/client.d.mts",
      "default": "./lib/client.mjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "@yeisme/dsh-template-registry": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsdown": "^0.22.14",
    "vitest": "^3.2.7",
    "@types/react": "~18.3.31"
  }
}
