{
  "name": "@yeisme/dsh-client-ui-session-cookie-manager",
  "version": "0.1.0-rc.1",
  "description": "DSH login-state profile manager (Phase 1): per-site profile metadata CRUD, read-only account composition, quota skeleton, honest no-seam degradation",
  "main": "lib/index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && tsdown",
    "bundle": "tsdown"
  },
  "license": "MIT",
  "type": "module",
  "types": "lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/index.js",
    "lib/panel.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@yeisme/dsh-client-ui-visual-kit": "workspace:^"
  }
}
