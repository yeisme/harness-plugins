{
  "name": "@yeisme/dsh-client-ui-surface",
  "version": "0.1.0-rc.1",
  "description": "Shared React composition contract for Yeisme DSH Web panes, dialogs, inspectors, workspaces, and micro surfaces",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && tsdown src/index.tsx --out-dir lib --format esm --dts --clean"
  },
  "dependencies": {
    "@yeisme/dsh-client-ui-visual-kit": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6 <0.2.0",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~18.3.31",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
