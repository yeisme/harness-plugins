{
  "name": "@yeisme/dsh-host-ordo-agent-ops",
  "description": "Deprecated compatibility shim for the unified @yeisme/dsh-ordo-agent-ops Host projection",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeisme/harness-plugins.git",
    "directory": "packages/host/ordo-agent-ops"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/types/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/types/typert.d.ts",
      "default": "./lib/types/typert.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/types/remote.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@yeisme/dsh-ordo-agent-ops": "workspace:0.1.0-rc.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "typecheck": "pnpm --filter @yeisme/dsh-ordo-agent-ops run build && tsc -p tsconfig.json --noEmit",
    "build": "pnpm --filter @yeisme/dsh-ordo-agent-ops run build && tsc -p tsconfig.json",
    "test": "vitest run"
  }
}
