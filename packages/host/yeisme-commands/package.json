{
  "type": "module",
  "name": "@yeisme/dsh-host-yeisme-commands",
  "version": "0.1.0-rc.1",
  "description": "Yeisme-prefixed DSH command registration helpers and the yeismo-notice example command",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsdown src/index.ts --out-dir lib --format esm --dts --clean",
    "test:slash-conformance": "bun scripts/run-slash-conformance.mjs",
    "test:slash-browser": "node scripts/run-slash-browser-evidence.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.6 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6"
  }
}
