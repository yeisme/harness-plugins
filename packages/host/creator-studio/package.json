{
  "name": "@yeisme/dsh-creator-studio-host",
  "version": "0.1.0-rc.1",
  "description": "Typed owner adapter directory and safe Host Remote for the DSH Creator Studio",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "scripts": {
    "typecheck": "pnpm --filter @yeisme/dsh-pane-protocol run build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "pnpm --filter @yeisme/dsh-pane-protocol run build && tsc -p tsconfig.json && tsdown"
  },
  "dependencies": {
    "@yeisme/dsh-pane-protocol": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
