{
  "name": "@yeisme/dsh-ai-drama-director",
  "version": "0.1.0-rc.1",
  "description": "AI Drama Director Pack host and client units: context, typed /drama, events, Workbench handoff (V1 + V2 bridge), and Director preset",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./pipeline-gateway": {
      "types": "./lib/types/pipeline-gateway.d.ts",
      "default": "./lib/pipeline-gateway.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "fixtures/**",
    "scripts/generate-bridge-fixtures.mjs",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && tsdown",
    "verify:opc-cross-entry": "node ../../../scripts/verify-scaena-opc-cross-entry.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@yeisme/dsh-pane-protocol": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@yeisme/dsh-3d-director-host": "workspace:*",
    "@yeisme/dsh-creator-studio-host": "workspace:^",
    "@yeisme/dsh-pane-protocol": "workspace:*",
    "@yeisme/dsh-plugin-contracts": "workspace:*"
  }
}
