{
  "name": "@yeisme/dsh-plugin-toolchain",
  "version": "0.1.0-rc.1",
  "description": "DSH plugin consistency toolchain: declaration-lint, safe-projection-audit, dispose-hmr-conformance, visual-token-conformance and bundle contract checks behind pnpm check:plugins",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cli": {
      "types": "./lib/cli.d.mts",
      "default": "./lib/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && tsdown"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@yeisme/dsh-plugin-catalog": "workspace:*",
    "@yeisme/dsh-plugin-contracts": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
