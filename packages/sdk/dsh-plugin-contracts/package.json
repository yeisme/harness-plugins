{
  "name": "@yeisme/dsh-plugin-contracts",
  "version": "0.1.0-rc.1",
  "description": "DSH plugin internal contracts: safe projection metadata, capability probe degradation, dispose/subscription shapes shared across harness-plugins packages",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && tsdown"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
