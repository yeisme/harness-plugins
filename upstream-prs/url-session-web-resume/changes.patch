+export function resumeUrlSuffix(resumeSession: string | undefined, historyFallback: boolean): string {
+  if (resumeSession === undefined || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(resumeSession)) return ''
+  const encoded = encodeURIComponent(resumeSession)
+  return historyFallback ? `/s/${encoded}` : `/?s=${encoded}`
