+async function preserveBootEvidence(page: Page | undefined, name: string): Promise<void> {
+  const evidenceDir = process.env.DSH_REFERENCE_EVIDENCE_DIR
+  if (page === undefined || evidenceDir === undefined) return
+  await mkdir(evidenceDir, { recursive: true })
+  await page.screenshot({ path: join(evidenceDir, `${name}.png`), fullPage: true }).catch(() => {})
+}
+
+function completion(): ReplayEntry {
+  const chunks: StreamChunk[] = [
+    { type: 'block-start', index: 0, blockType: 'text' },
+    { type: 'text-delta', index: 0, text: RESPONSE },
+    { type: 'block-end', index: 0, block: { type: 'text', text: RESPONSE } },
+    { type: 'usage', usage: { inputTokens: 256, outputTokens: 16 } },
+    { type: 'finish', reason: { kind: 'stop' } },
+  ]
+  return { kind: 'chunks', chunks }
+}
+
+function eventText(event: SessionEvent): string {
+  return JSON.stringify(event)
+}
+
+async function pickFirstReferenceInSection(page: Page, input: Locator, section: string, expectedCount: number, named?: string): Promise<string> {
+  await input.click()
+  await input.press('End')
+  await page.keyboard.type('@')
+  const listbox = page.getByRole('listbox')
+  await listbox.waitFor({ timeout: 15_000 })
+  const heading = listbox.locator('[role="presentation"]').filter({ hasText: new RegExp(`^${section}$`) }).first()
+  await heading.waitFor({ timeout: 15_000 })
+  const options = heading.locator('xpath=following-sibling::button[@role="option"]')
+  const option = named === undefined ? options.first() : options.filter({ hasText: new RegExp(named.replace(/[.*+?^${}()|[\]\\]/gu, '\\$&')) }).first()
+  const label = (await option.locator('span').first().textContent())?.trim()
+  if (label === undefined || label === '') throw new Error(`${section} reference catalog returned no selectable row`)
+  await option.click()
+  await expect.poll(() => input.locator('[data-composer-chip]').count(), { timeout: 15_000 }).toBe(expectedCount)
+  return label
+}
