+  it('restores one structured chip occurrence through insert/delete undo-redo history', () => {
+    vi.useFakeTimers()
+    try {
+      const { shell, textarea, view } = bench()
+      seedChineseCandidate(shell)
+      vi.advanceTimersByTime(1100)
+      const structured = insertChineseStructuredChip(shell)
+      vi.advanceTimersByTime(1100)
+
+      fireEvent.keyDown(textarea, { key: 'z', keyCode: 90, ctrlKey: true })
+      flushHistory(shell)
+      expect(view.container.querySelector('[data-composer-chip]')).toBeNull()
+      expect(shell.snapshot).toMatchObject({ draft: '中文 @候选', occurrences: [] })
+
+      fireEvent.keyDown(textarea, { key: 'z', keyCode: 90, ctrlKey: true, shiftKey: true })
+      flushHistory(shell)
+      expect(view.container.querySelector('[data-composer-chip]')?.textContent).toBe('设计文档')
+      expect(shell.snapshot.occurrences).toMatchObject([{ offset: 3, length: 5, structured }])
+
+      vi.advanceTimersByTime(1100)
+      act(() => {
+        shell.editor.update(() => {
+          expect($replaceDetectSpanWithText({ start: 3, end: 4 }, '')).toBe(true)
+        }, { discrete: true })
+      })
+      expect(shell.snapshot).toMatchObject({ draft: '中文  ', occurrences: [] })
+
+      fireEvent.keyDown(textarea, { key: 'z', keyCode: 90, ctrlKey: true })
+      flushHistory(shell)
+      expect(view.container.querySelector('[data-composer-chip]')?.textContent).toBe('设计文档')
+      expect(shell.snapshot.occurrences).toMatchObject([{ structured }])
+
+      fireEvent.keyDown(textarea, { key: 'z', keyCode: 90, ctrlKey: true, shiftKey: true })
+      flushHistory(shell)
+      expect(view.container.querySelector('[data-composer-chip]')).toBeNull()
+      expect(shell.snapshot).toMatchObject({ draft: '中文  ', occurrences: [] })
+    } finally {
+      vi.useRealTimers()
+    }
+  })
