new file mode 100644
index 0000000..05e16b8
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/reference-target-chooser.tsx
@@ -0,0 +1,186 @@
+import { useEffect, useState, useSyncExternalStore } from 'react'
+import { Button, Modal } from '@deepseek-ai/dsh-client-ui-primitives'
+import css from './reference-target-chooser.module.css'
+
+export interface ReferenceTargetChoice {
+  readonly workspaceId: string
+  readonly workspaceTitle: string
+  readonly conversationId: string
+  readonly title: string
+}
+
+export type ReferenceTargetChoiceResult =
+  | { readonly status: 'selected'; readonly choice: ReferenceTargetChoice }
+  | { readonly status: 'cancelled' }
+  | { readonly status: 'unavailable'; readonly reason: string }
+
+interface ReferenceTargetChooserSnapshot {
+  readonly open: boolean
+  readonly choices: readonly ReferenceTargetChoice[]
+  readonly currentConversationId?: string
+}
+
+interface PendingChoice {
+  readonly resolve: (result: ReferenceTargetChoiceResult) => void
+  readonly signal?: AbortSignal
+  onAbort?: () => void
+}
+
+/** One host-owned modal request at a time; session rows remain controller-owned facts. */
+export class ReferenceTargetChooserController {
+  private snapshotValue: ReferenceTargetChooserSnapshot = { open: false, choices: [] }
+  private readonly listeners = new Set<() => void>()
+  private pending: PendingChoice | undefined
+
+  snapshot = (): ReferenceTargetChooserSnapshot => this.snapshotValue
+
+  subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  choose(
+    choices: readonly ReferenceTargetChoice[],
+    currentConversationId: string | undefined,
+    signal?: AbortSignal,
+  ): Promise<ReferenceTargetChoiceResult> {
+    if (signal?.aborted === true) return Promise.resolve({ status: 'cancelled' })
+    if (choices.length === 0) return Promise.resolve({ status: 'unavailable', reason: 'no available conversation target' })
+    this.settle({ status: 'cancelled' })
+    return new Promise(resolve => {
+      const pending: PendingChoice = { resolve, ...(signal === undefined ? {} : { signal }) }
+      if (signal !== undefined) {
+        const onAbort = (): void => { if (this.pending === pending) this.settle({ status: 'cancelled' }) }
+        pending.onAbort = onAbort
+        signal.addEventListener('abort', onAbort, { once: true })
+      }
+      this.pending = pending
+      this.snapshotValue = {
+        open: true,
+        choices: choices.map(choice => ({ ...choice })),
+        ...(currentConversationId === undefined ? {} : { currentConversationId }),
+      }
+      this.publish()
+    })
+  }
+
+  select(conversationId: string): void {
+    const choice = this.snapshotValue.choices.find(item => item.conversationId === conversationId)
+    if (choice !== undefined) this.settle({ status: 'selected', choice })
+  }
+
+  cancel(): void { this.settle({ status: 'cancelled' }) }
+
+  dispose(): void {
+    this.settle({ status: 'unavailable', reason: 'conversation target chooser is unavailable' })
+    this.listeners.clear()
+  }
+
+  private settle(result: ReferenceTargetChoiceResult): void {
+    const pending = this.pending
+    if (pending === undefined) return
+    this.pending = undefined
+    if (pending.signal !== undefined && pending.onAbort !== undefined) {
+      pending.signal.removeEventListener('abort', pending.onAbort)
+    }
+    this.snapshotValue = { open: false, choices: [] }
+    this.publish()
+    pending.resolve(result)
+  }
+
+  private publish(): void {
+    for (const listener of this.listeners) listener()
+  }
+}
+
+export interface ReferenceTargetChooserLabels {
+  readonly title: string
+  readonly description: string
+  readonly close: string
+  readonly cancel: string
+  readonly current: string
+}
+
+export interface ReferenceTargetBridgeFace {
+  snapshot(): {
+    readonly available: boolean
+    readonly target?: { readonly conversationId: string; readonly title?: string }
+  }
+  subscribe(listener: () => void): () => void
+  chooseTarget(signal?: AbortSignal): Promise<ReferenceTargetChoiceResult | { readonly status: 'selected'; readonly target: { readonly conversationId: string; readonly title?: string } }>
+}
+
+export interface ReferenceTargetControlLabels {
+  readonly target: string
+  readonly none: string
+  readonly change: string
+  readonly unavailable: string
+}
+
+/** Input-area target status and entry into the same host-owned chooser. */
+export function createReferenceTargetControl(
+  bridge: ReferenceTargetBridgeFace,
+  labels: ReferenceTargetControlLabels,
+) {
+  return function ReferenceTargetControl() {
+    const [, setRevision] = useState(0)
+    useEffect(() => bridge.subscribe(() => { setRevision(value => value + 1) }), [])
+    const snapshot = bridge.snapshot()
+    const [pending, setPending] = useState(false)
+    const choose = (anchor: HTMLElement): void => {
+      if (pending) return
+      setPending(true)
+      void bridge.chooseTarget().finally(() => {
+        setPending(false)
+        queueMicrotask(() => { if (anchor.isConnected) anchor.focus({ preventScroll: true }) })
+      })
+    }
+    return (
+      <div className={css.target} data-composer-reference-target>
+        <span className={css.targetLabel}>
+          {labels.target}: <strong>{snapshot.target?.title ?? snapshot.target?.conversationId ?? labels.none}</strong>
+        </span>
+        <Button variant="toolbar" size="sm" disabled={pending} onClick={event => { choose(event.currentTarget) }}>
+          {pending ? labels.unavailable : labels.change}
+        </Button>
+      </div>
+    )
+  }
+}
+
+/** Host overlay listing only sessions present in the authoritative workspace projection. */
+export function createReferenceTargetChooser(
+  controller: ReferenceTargetChooserController,
+  labels: ReferenceTargetChooserLabels,
+) {
+  return function ReferenceTargetChooser() {
+    const snapshot = useSyncExternalStore(controller.subscribe, controller.snapshot, controller.snapshot)
+    return (
+      <Modal
+        open={snapshot.open}
+        onClose={() => { controller.cancel() }}
+        closeLabel={labels.close}
+        title={labels.title}
+        description={labels.description}
+        footer={<Button variant="outline" onClick={() => { controller.cancel() }}>{labels.cancel}</Button>}
+      >
+        <div className={css.list}>
+          {snapshot.choices.map(choice => (
+            <button
+              key={`${choice.workspaceId}\u0000${choice.conversationId}`}
+              type="button"
+              className={css.row}
+              data-composer-reference-target-option={choice.conversationId}
+              aria-current={choice.conversationId === snapshot.currentConversationId ? 'true' : undefined}
+              onClick={() => { controller.select(choice.conversationId) }}
+            >
+              <span className={css.title}>{choice.title}</span>
+              <span className={css.workspace}>{choice.workspaceTitle}</span>
+              {choice.conversationId === snapshot.currentConversationId && <span className={css.current}>{labels.current}</span>}
+            </button>
+          ))}
+        </div>
+      </Modal>
+    )
+  }
+}
