@@ -0,0 +1,38 @@
+/** Owner-side image-region derivation. */
+
+import sharp from 'sharp'
+import { AttachmentError, type DeriveImageRegionAttachment, type SaveImageAttachment } from '@deepseek-ai/dsh-attachment'
+import type { DecodedImageLimits } from './image.ts'
+import { detectImage } from './image.ts'
+
+function validRegion(region: DeriveImageRegionAttachment['region']): boolean {
+  return [region.x, region.y, region.width, region.height].every(Number.isFinite)
+    && region.x >= 0 && region.y >= 0 && region.width > 0 && region.height > 0
+    && region.x + region.width <= 1 && region.y + region.height <= 1
+}
+
+/** Decode, orient, crop, and strip metadata without retaining pixels outside the requested region. */
+export async function deriveImageRegion(
+  input: DeriveImageRegionAttachment,
+  limits: DecodedImageLimits,
+): Promise<SaveImageAttachment> {
+  if (!validRegion(input.region)) throw new AttachmentError('Image region is invalid.', 'INVALID_IMAGE')
+  const detected = await detectImage(input.data, limits)
+  if (detected.mediaType !== input.mediaType) throw new AttachmentError('Declared image type does not match its bytes.', 'IMAGE_TYPE_MISMATCH')
+  const left = Math.min(detected.width - 1, Math.floor(input.region.x * detected.width))
+  const top = Math.min(detected.height - 1, Math.floor(input.region.y * detected.height))
+  const right = Math.max(left + 1, Math.min(detected.width, Math.ceil((input.region.x + input.region.width) * detected.width)))
+  const bottom = Math.max(top + 1, Math.min(detected.height, Math.ceil((input.region.y + input.region.height) * detected.height)))
+  try {
+    const data = new Uint8Array(await sharp(input.data, { failOn: 'error', limitInputPixels: false })
+      .rotate()
+      .extract({ left, top, width: right - left, height: bottom - top })
+      .toColourspace('srgb')
+      .png()
+      .toBuffer())
+    return { data, mediaType: 'image/png', ...(input.name === undefined ? {} : { name: input.name }) }
+  } catch (error) {
+    if (error instanceof AttachmentError) throw error
+    throw new AttachmentError('Unable to derive the requested image region.', 'INVALID_IMAGE', { cause: error })
+  }
+}
