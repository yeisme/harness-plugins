+/** Session-addressed Tool schema catalog Remote. */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type { ScopeKey } from '@deepseek-ai/dsh-scope'
+import { SessionQueryError } from '@deepseek-ai/dsh-session-query'
+import { Remote, RemoteError, TypertRemoteService } from '@deepseek-ai/dsh-typert-protocol'
+import type { ToolListRequest, ToolListValue } from './types.ts'
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Host owner of the Session-addressed reference Tool catalog. */
+    sessionToolCatalog: SessionToolCatalog
+  }
+}
+
+/** Exposes the exact core Tool registry visible to a live or standing Session scope. */
+export class SessionToolCatalog extends TypertRemoteService {
+  static inject = ['agents', 'sessionQuery', 'tools', 'typert']
+
+  constructor(ctx: Context) {
+    super(ctx, 'sessionToolCatalog', { namespace: 'referenceTools' })
+  }
+
+  @Remote
+  async list(request: ToolListRequest, signal: AbortSignal): Promise<ToolListValue> {
+    signal.throwIfAborted()
+    let agentPreset: string | undefined
+    try {
+      using observation = await this.ctx.sessionQuery.observeSession(request.sessionId, { signal })
+      agentPreset = observation.projections?.values.agentPreset ?? undefined
+    } catch (error) {
+      if (error instanceof SessionQueryError && error.code === 'SESSION_QUERY_SESSION_NOT_FOUND') {
+        throw new RemoteError('session/not-found', `session "${request.sessionId}" not found`, { sessionId: request.sessionId })
+      }
+      throw new RemoteError('gateway/internal', `session "${request.sessionId}" could not be inspected: ${String(error)}`, {})
+    }
+    const scope = await this.scopeFor(request.sessionId, agentPreset)
+    return {
+      tools: this.ctx.tools.schemas(scope).map(tool => ({
+        name: tool.name,
+        ...(tool.description === undefined ? {} : { description: tool.description }),
+      })),
+    }
+  }
+
+  private async scopeFor(sessionId: SessionId, agentPreset: string | undefined): Promise<ScopeKey | undefined> {
+    const live = this.ctx.agents.get(sessionId)
+    if (live !== undefined) return live
+    const presets = this.ctx.get('agentPresets')
+    if (presets === undefined) return undefined
+    try {
+      return await presets.standingKeyFor(agentPreset)
+    } catch {
+      return undefined
+    }
+  }
+}
+
+export default SessionToolCatalog
