+// @vitest-environment jsdom
+/**
+ * Structured-reference target lifecycle coverage over the mounted Conversation
+ * provider. These cases use the real bridge, session scopes, InputState, and
+ * host insert event; no standalone target controller is substituted.
+ */
+import { describe, expect, it, vi } from 'vitest'
+import type { ISession } from '@deepseek-ai/dsh-api-session-controller/client'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import {
+  SlotTestRuntime, stubSettingsScope, usePinnedBrowserLanguages,
+} from '@deepseek-ai/dsh-client-test-runtime'
+import type { SessionBehaviorOverrides } from '@deepseek-ai/dsh-client-test-runtime'
+import { apply, inject } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { WorkspaceId } from '@deepseek-ai/dsh-workspace/types'
+
+usePinnedBrowserLanguages('zh-CN')
+
+const FIRST = 'target-first' as SessionId
+const SECOND = 'target-second' as SessionId
+const FIRST_WORKSPACE = 'workspace-first' as WorkspaceId
+const SECOND_WORKSPACE = 'workspace-second' as WorkspaceId
+
+type Target = {
+  readonly workspaceId: string
+  readonly conversationId: string
+  readonly draftRevision: number
+  readonly caret: { readonly start: number; readonly end: number }
+}
+
+type StructuredReference = {
+  readonly id: string
+  readonly owner: string
+  readonly ref: string
+  readonly kind: 'file'
+  readonly intent: 'content'
+  readonly version: string
+  readonly digest: string
+  readonly scope: string
+  readonly label: string
+}
+
+interface ReferenceBridge {
+  snapshot(): {
+    readonly available: boolean
+    readonly reason?: string
+    readonly target?: Target
+    readonly references?: readonly StructuredReference[]
+  }
+}
+
+function sessionFakeFor() {
+  return {
+    loadOlder: vi.fn<ISession['loadOlder']>(() => Promise.resolve()),
+    prompt: vi.fn<ISession['prompt']>(() => Promise.resolve({ ok: true, value: { accepted: true } })),
+    cancel: vi.fn<ISession['cancel']>(() => Promise.resolve({ ok: true, value: { accepted: true } })),
+  } satisfies SessionBehaviorOverrides
+}
+
+function reference(id: string, label: string): StructuredReference {
+  return {
+    id,
+    owner: 'fixture-owner',
+    ref: `file:${id}`,
+    kind: 'file',
+    intent: 'content',
+    version: 'fixture-v1',
+    digest: `digest:${id}`,
+    scope: 'file/full',
+    label,
+  }
+}
+
+async function bench() {
+  const runtime = await SlotTestRuntime.create()
+  runtime.ctx.provide('settingsScope', { bind: () => stubSettingsScope().scope } as never)
+  runtime.ctx.provide('uiWorkspace', { connectWorkspace: vi.fn(async () => FIRST) } as never)
+  await runtime.sessions.add({
+    id: FIRST,
+    summary: { title: 'First', displayTitle: 'First', cwd: '/first' },
+    session: sessionFakeFor(),
+  }, { current: false })
+  const locale = new LocaleRuntime(runtime.ctx)
+  runtime.ctx.provide('locale', locale)
+  runtime.slots.installLocale(locale)
+  await runtime.root.declare({
+    conversation: { kind: 'single', scope: 'session-maybe' },
+  } as never, (_props: { renderSlot?: unknown }) => null)
+  const feature = await runtime.mount({ inject: [...inject], apply })
+  runtime.renderRoot()
+  return {
+    runtime,
+    feature,
+    bridge: (): ReferenceBridge => runtime.ctx.get('composerReferenceBridge' as never) as unknown as ReferenceBridge,
+    input: (id: SessionId) => runtime.ctx.conversation.input.for(runtime.sessions.scope(id)!),
+  }
+}
+
+async function addSecondSession(runtime: Awaited<ReturnType<typeof bench>>['runtime']): Promise<void> {
+  await runtime.sessions.add({
+    id: SECOND,
+    summary: { title: 'Second', displayTitle: 'Second', cwd: '/second' },
+    session: sessionFakeFor(),
+  }, { current: false })
+}
+
+async function setWorkspaceOwners(runtime: Awaited<ReturnType<typeof bench>>['runtime']): Promise<void> {
+  await runtime.workspaces.update((draft) => {
+    draft.items = [
+      { workspaceId: FIRST_WORKSPACE, title: 'First workspace', path: '/first', sessionIds: [FIRST], createdAt: '2026-09-05T00:00:00.000Z', updatedAt: '2026-09-05T00:00:00.000Z' },
+      { workspaceId: SECOND_WORKSPACE, title: 'Second workspace', path: '/second', sessionIds: [SECOND], createdAt: '2026-09-05T00:00:00.000Z', updatedAt: '2026-09-05T00:00:00.000Z' },
+    ]
+  })
+}
+
+function targetOf(bridge: ReferenceBridge): Target {
+  const snapshot = bridge.snapshot()
+  expect(snapshot.available).toBe(true)
+  if (snapshot.target === undefined) throw new Error('reference bridge reported available without a target')
+  return snapshot.target
+}
+
+function requestInsert(requestId: string, target: Target, structured: StructuredReference): void {
+  window.dispatchEvent(new CustomEvent('dsh-composer-reference:insert', { detail: {
+    version: 1,
+    requestId,
+    target,
+    reference: structured,
+  } }))
+}
+
+describe('structured reference target lifecycle', () => {
+  it('isolates structured drafts across an explicit conversation switch and restores each target on return', async () => {
+    const b = await bench()
+    try {
+      await addSecondSession(b.runtime)
+      await setWorkspaceOwners(b.runtime)
+      const receipts: CustomEvent[] = []
+      const receive = (event: Event) => { receipts.push(event as CustomEvent) }
+      window.addEventListener('dsh-composer-reference:insert-result', receive)
+
+      await b.runtime.sessions.setCurrent(FIRST)
+      const firstInput = b.input(FIRST)
+      firstInput.setDraft('first draft')
+      const firstReference = reference('first-ref', 'first.txt')
+      requestInsert('first-insert', targetOf(b.bridge()), firstReference)
+      await vi.waitFor(() => {
+        expect(firstInput.state.getSnapshot()).toMatchObject({
+          draft: 'first draft@first.txt ', occurrences: [{ structured: firstReference }],
+        })
+      })
+
+      await b.runtime.sessions.setCurrent(SECOND)
+      const secondInput = b.input(SECOND)
+      expect(b.bridge().snapshot()).toMatchObject({ available: true, references: [] })
+      secondInput.setDraft('second draft')
+      const secondReference = reference('second-ref', 'second.txt')
+      requestInsert('second-insert', targetOf(b.bridge()), secondReference)
+      await vi.waitFor(() => {
+        expect(secondInput.state.getSnapshot()).toMatchObject({
+          draft: 'second draft@second.txt ', occurrences: [{ structured: secondReference }],
+        })
+      })
+      expect(receipts.map(receipt => receipt.detail)).toEqual(expect.arrayContaining([
+        expect.objectContaining({ requestId: 'first-insert', ok: true }),
+        expect.objectContaining({ requestId: 'second-insert', ok: true }),
+      ]))
+
+      await b.runtime.sessions.setCurrent(FIRST)
+      expect(b.bridge().snapshot()).toMatchObject({
+        target: expect.objectContaining({ workspaceId: FIRST_WORKSPACE, conversationId: FIRST }),
+        references: [firstReference],
+      })
+      expect(firstInput.state.getSnapshot()).toMatchObject({
+        draft: 'first draft@first.txt ', occurrences: [{ structured: firstReference }],
+      })
+
+      await b.runtime.sessions.setCurrent(SECOND)
+      expect(b.bridge().snapshot()).toMatchObject({
+        target: expect.objectContaining({ workspaceId: SECOND_WORKSPACE, conversationId: SECOND }),
+        references: [secondReference],
+      })
+      expect(secondInput.state.getSnapshot()).toMatchObject({
+        draft: 'second draft@second.txt ', occurrences: [{ structured: secondReference }],
+      })
+      window.removeEventListener('dsh-composer-reference:insert-result', receive)
+    } finally {
+      await b.runtime.dispose()
+    }
+  })
+
+  it('reports unavailable with no selected target and refuses a captured target after its conversation closes', async () => {
+    const b = await bench()
+    try {
+      const receipts: CustomEvent[] = []
+      const receive = (event: Event) => { receipts.push(event as CustomEvent) }
+      window.addEventListener('dsh-composer-reference:insert-result', receive)
+      expect(b.bridge().snapshot()).toMatchObject({
+        available: false,
+        reason: 'select a main conversation before adding a reference',
+      })
+      requestInsert('no-target', {
+        workspaceId: 'missing-workspace', conversationId: 'missing-conversation', draftRevision: 0, caret: { start: 0, end: 0 },
+      }, reference('missing-ref', 'missing.txt'))
+      expect(receipts.at(-1)?.detail).toMatchObject({ requestId: 'no-target', ok: false, reason: expect.stringContaining('unavailable') })
+
+      await setWorkspaceOwners(b.runtime)
+      await b.runtime.sessions.setCurrent(FIRST)
+      const firstInput = b.input(FIRST)
+      firstInput.setDraft('closed target draft')
+      const captured = targetOf(b.bridge())
+      await b.runtime.sessions.remove(FIRST)
+      expect(b.bridge().snapshot()).toMatchObject({ available: false })
+      requestInsert('closed-target', captured, reference('closed-ref', 'closed.txt'))
+      expect(receipts.at(-1)?.detail).toMatchObject({ requestId: 'closed-target', ok: false, reason: expect.stringContaining('unavailable') })
+      expect(firstInput.state.getSnapshot()).toMatchObject({ draft: 'closed target draft', occurrences: [] })
+      window.removeEventListener('dsh-composer-reference:insert-result', receive)
+    } finally {
+      await b.runtime.dispose()
+    }
+  })
+
+  it('rejects an old workspace or draft revision without contaminating the other conversation', async () => {
+    const b = await bench()
+    try {
+      await addSecondSession(b.runtime)
+      await setWorkspaceOwners(b.runtime)
+      const receipts: CustomEvent[] = []
+      const receive = (event: Event) => { receipts.push(event as CustomEvent) }
+      window.addEventListener('dsh-composer-reference:insert-result', receive)
+
+      await b.runtime.sessions.setCurrent(SECOND)
+      const secondInput = b.input(SECOND)
+      secondInput.setDraft('second draft')
+      const secondReference = reference('second-kept', 'keep.txt')
+      requestInsert('second-kept-insert', targetOf(b.bridge()), secondReference)
+      await vi.waitFor(() => { expect(secondInput.state.getSnapshot().occurrences).toMatchObject([{ structured: secondReference }]) })
+
+      await b.runtime.sessions.setCurrent(FIRST)
+      const firstInput = b.input(FIRST)
+      firstInput.setDraft('first draft')
+      const staleRevision = targetOf(b.bridge())
+      firstInput.setDraft('first draft changed')
+      requestInsert('stale-revision', staleRevision, reference('stale-revision-ref', 'stale.txt'))
+      expect(receipts.at(-1)?.detail).toMatchObject({ requestId: 'stale-revision', ok: false, reason: expect.stringContaining('draft changed') })
+      expect(firstInput.state.getSnapshot()).toMatchObject({ draft: 'first draft changed', occurrences: [] })
+
+      const freshTarget = targetOf(b.bridge())
+      requestInsert('old-workspace', { ...freshTarget, workspaceId: SECOND_WORKSPACE }, reference('old-workspace-ref', 'wrong.txt'))
+      expect(receipts.at(-1)?.detail).toMatchObject({ requestId: 'old-workspace', ok: false, reason: expect.stringContaining('unavailable') })
+      expect(firstInput.state.getSnapshot().occurrences).toEqual([])
+      expect(secondInput.state.getSnapshot()).toMatchObject({
+        draft: 'second draft@keep.txt ', occurrences: [{ structured: secondReference }],
+      })
+      window.removeEventListener('dsh-composer-reference:insert-result', receive)
+    } finally {
+      await b.runtime.dispose()
+    }
+  })
+})
