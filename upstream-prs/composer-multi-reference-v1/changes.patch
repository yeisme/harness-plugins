+    }, { start: 3, end: 6, draftRev: shell.snapshot.draftRev })).toBe(true)
+  })
+  return structured
+}
+
+function flushHistory(shell: SessionInputShell): void {
+  act(() => { shell.editor.update(() => {}, { discrete: true }) })
+}
+
+describe('reference chip input lifecycle', () => {
+  it('keeps a Chinese chip through IME candidate Enter and Safari closing Enter, then submits its exact structured payload once', async () => {
+    vi.useFakeTimers()
