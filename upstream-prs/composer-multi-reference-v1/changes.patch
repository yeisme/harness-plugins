+import { describe, expect, it, vi } from 'vitest'
+import { SessionTerminalReferenceCatalog, terminalReferenceProof } from '../src/terminal-reference-catalog.ts'
+
+describe('SessionTerminalReferenceCatalog', () => {
+  it('issues an exact SHA-256 proof for the live Session owner scrollback', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(AgentRegistry)
+    const session = ctx.sessions.create()
+    const owner = { id: session.id, session, ctx, status: 'running', inbox: { nextTurn: [], nextStep: [] } }
+    ctx.agents.register(owner as never)
+    const row = { sessionId: 'pty-1', name: 'reference-terminal', type: 'shell', status: { kind: 'running' } }
+    const read = { text: 'ready\n', totalLines: 1, lineBegin: 0, lineEnd: 1, truncated: false }
+    const list = vi.fn(() => [row])
+    const readOwned = vi.fn(() => read)
+    ctx.provide('terminals' as never, { list, read: readOwned } as never)
+    const catalog = new SessionTerminalReferenceCatalog(ctx)
+
+    await expect(catalog.list({ sessionId: session.id }, new AbortController().signal)).resolves.toEqual({
+      terminals: [{
+        terminalId: 'pty-1', name: 'reference-terminal', type: 'shell', status: 'running',
+        ...terminalReferenceProof(row, read), scope: 'terminal/scrollback', preview: 'ready',
+      }],
+    })
+    expect(list).toHaveBeenCalledWith(owner)
+    expect(readOwned).toHaveBeenCalledWith(owner, 'pty-1', { offset: 0, count: 200 })
+  })
+
+  it('rejects a Session without a live Agent owner', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(AgentRegistry)
+    ctx.provide('terminals' as never, { list: vi.fn(), read: vi.fn() } as never)
+    const catalog = new SessionTerminalReferenceCatalog(ctx)
+    await expect(catalog.list({ sessionId: 'missing' as never }, new AbortController().signal))
+      .rejects.toMatchObject({ code: 'session/not-found' })
+  })
+
+  it('changes the proof when same-sized scrollback text changes', () => {
+    const row = { sessionId: 'pty-1', type: 'shell', status: { kind: 'running' } }
+    const base = { totalLines: 1, lineBegin: 0, lineEnd: 1, truncated: false }
