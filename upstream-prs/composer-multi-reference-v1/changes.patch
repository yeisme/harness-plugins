+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import SessionStore, { SessionId, SessionLogOffset } from '@deepseek-ai/dsh-session'
+import type { SessionObservation } from '@deepseek-ai/dsh-session-query'
+import { describe, expect, it, vi } from 'vitest'
+import { SessionToolCatalog } from '../src/tool-catalog.ts'
+
+function observation(sessionId: SessionId): SessionObservation {
+  const lease = (): SessionObservation => ({
+    source: 'prepared',
+    header: { version: 0, id: sessionId, createdAt: 1, isSeeded: false, cwd: '/project' },
+    events: Object.freeze([]),
+    inheritedEventCount: SessionLogOffset(0),
+    cursor: -1,
+    projections: { asOfSeq: -1, values: {} },
+    retain: lease,
+    [Symbol.dispose]: () => {},
+  })
+  return lease()
+}
+
+describe('SessionToolCatalog', () => {
+  it('projects the core Tool registry for a cold Session without resuming it', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(AgentRegistry)
+    const sessionId = SessionId('cold-tools')
+    const observed = observation(sessionId)
+    const dispose = vi.spyOn(observed, Symbol.dispose)
+    ctx.provide('sessionQuery', { observeSession: vi.fn(() => Promise.resolve(observed)) } as never)
+    const schemas = vi.fn(() => [{ name: 'read', description: 'Read a file', inputSchema: {} }])
+    ctx.provide('tools', { schemas } as never)
+    const catalog = new SessionToolCatalog(ctx)
+    await expect(catalog.list({ sessionId }, new AbortController().signal)).resolves.toEqual({
+      tools: [{ name: 'read', description: 'Read a file' }],
+    })
+    expect(schemas).toHaveBeenCalledWith(undefined)
+    expect(dispose).toHaveBeenCalledOnce()
+    expect(ctx.agents.list()).toEqual([])
+  })
+})
