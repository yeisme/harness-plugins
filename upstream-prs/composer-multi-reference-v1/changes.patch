@@ -0,0 +1,87 @@
+/** Session-addressed owner catalog for bounded terminal scrollback references. */
+
+import { createHash } from 'node:crypto'
+import type { Context } from '@deepseek-ai/cordis'
+import { Remote, RemoteError, TypertRemoteService } from '@deepseek-ai/dsh-typert-protocol'
+import type { TerminalReferenceListRequest, TerminalReferenceListValue } from './types.ts'
+
+interface TerminalRow {
+  readonly sessionId: string
+  readonly name?: string
+  readonly type: string
+  readonly status: { readonly kind?: unknown }
+}
+
+interface TerminalRead {
+  readonly text: string
+  readonly totalLines: number
+  readonly lineBegin: number
+  readonly lineEnd: number
+  readonly truncated: boolean
+}
+
+interface TerminalRegistryFace {
+  list(owner: unknown): readonly TerminalRow[]
+  read(owner: unknown, terminalId: string, request: { readonly offset: number; readonly count: number }): TerminalRead
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Host owner of `ctx.remote.referenceTerminals`. */
+    sessionTerminalReferenceCatalog: SessionTerminalReferenceCatalog
+  }
+}
+
+/** SHA-256 proof shared with the prompt-time terminal owner revalidation. */
+export function terminalReferenceProof(row: TerminalRow, read: TerminalRead): { readonly version: string; readonly digest: string } {
+  const value = JSON.stringify({
+    id: row.sessionId,
+    type: row.type,
+    status: row.status,
+    totalLines: read.totalLines,
+    lineBegin: read.lineBegin,
+    lineEnd: read.lineEnd,
+    truncated: read.truncated,
+    text: read.text,
+  })
+  const digest = createHash('sha256').update(value).digest('hex')
+  return { version: `sha256:${digest}`, digest }
+}
+
+/** Lists only terminals owned by the exact live Session Agent. */
+export class SessionTerminalReferenceCatalog extends TypertRemoteService {
+  static inject = ['agents', 'terminals', 'typert']
+
+  constructor(ctx: Context) {
+    super(ctx, 'sessionTerminalReferenceCatalog', { namespace: 'referenceTerminals' })
+  }
+
+  @Remote
+  async list(request: TerminalReferenceListRequest, signal: AbortSignal): Promise<TerminalReferenceListValue> {
+    signal.throwIfAborted()
+    const owner = this.ctx.agents.get(request.sessionId)
+    if (owner === undefined) {
+      throw new RemoteError('session/not-found', `session "${request.sessionId}" has no live terminal owner`, { sessionId: request.sessionId })
+    }
+    const terminals = this.ctx.get('terminals') as unknown as TerminalRegistryFace
+    return {
+      terminals: terminals.list(owner).slice(0, 8).map(row => {
+        signal.throwIfAborted()
+        const read = terminals.read(owner, row.sessionId, { offset: 0, count: 200 })
+        const proof = terminalReferenceProof(row, read)
+        return {
+          terminalId: row.sessionId,
+          ...(row.name === undefined ? {} : { name: row.name }),
+          type: row.type,
+          status: typeof row.status.kind === 'string' ? row.status.kind : 'unknown',
+          version: proof.version,
+          digest: proof.digest,
+          scope: 'terminal/scrollback' as const,
+          preview: read.text.replace(/\s+/gu, ' ').trim().slice(0, 240),
+        }
+      }),
+    }
+  }
+}
+
+export default SessionTerminalReferenceCatalog
