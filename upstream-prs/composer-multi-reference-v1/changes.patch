+    fireEvent.keyDown(textarea, { key: 'Enter' })
+    await vi.waitFor(() => {
+      expect(sink).toHaveBeenCalledWith(
+        '中文 @设计文档', [], 'queue', expect.any(AbortSignal), [structured],
+      )
+    })
