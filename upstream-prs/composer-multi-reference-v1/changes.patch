+// @vitest-environment jsdom
+/**
+ * Reference-chip lifecycle coverage over the real InputBar, Lexical editor,
+ * and SessionInputShell. Composition and history assertions stay here because
+ * they require the editor's installed DOM commands rather than a controller stub.
+ */
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import {
+  bindSnapshotSelector, conversationSnapshot as conversationFixture, makeTranslate,
+  sessionSnapshot as sessionFixture,
+} from '@deepseek-ai/dsh-client-test-runtime'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
