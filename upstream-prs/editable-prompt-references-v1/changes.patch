+// @vitest-environment jsdom
+import { describe, expect, it, vi } from 'vitest'
+import { $nodesOfType } from 'lexical'
+import type { Context } from '@deepseek-ai/cordis'
+import { SessionInputShell } from '../src/client/input/facade.ts'
+import { ReferenceChipNode } from '../src/client/input/editor/chip-node.tsx'
+import { REFRESH_REFERENCE_CHIP_COMMAND, UPDATE_REFERENCE_CHIP_COMMAND } from '../src/client/input/editor/reference-chip-actions.ts'
+import type { EditableReferenceRefreshOutcome, StructuredReference } from '../src/client/contract/input.ts'
+
+const commandImages = {
+  serialize: () => Promise.resolve([]),
+  release: () => {},
+  unsupportedNotice: (token: string) => token,
+}
+
+function reference(id: string): StructuredReference {
+  return {
+    id, owner: 'dsh.local', ref: `${id}.txt`, kind: 'selection', intent: 'content', version: 'v1', digest: 'old', scope: 'file/raw', window: { start: 0, end: 4 }, label: `${id}.txt`, projection: 'editable-prompt',
+    prompt: { version: 1, body: 'draft', originalBody: 'source', source: { owner: 'dsh.local', ref: `${id}.txt`, version: 'v1', scope: 'file/raw', digest: 'old' } },
+  }
+}
+
+function shellFor(referenceValue: StructuredReference, refresh: (value: StructuredReference) => Promise<StructuredReference | undefined>): SessionInputShell {
+  const shell = new SessionInputShell({ actx: {} as Context, defaultSink: vi.fn(), commandImages, refreshReference: refresh })
+  shell.setDraft('@r')
+  expect(shell.insertReference({ source: 'reference', ref: referenceValue.ref, label: referenceValue.label!, clipboardText: referenceValue.prompt!.body, structured: referenceValue }, { start: 0, end: 2, draftRev: shell.snapshot.draftRev })).toBe(true)
+  return shell
+}
+
+function keyOf(shell: SessionInputShell): string {
+  return shell.editor.getEditorState().read(() => $nodesOfType(ReferenceChipNode)[0]!.getKey())
+}
+
+describe('editable reference refresh occurrence routing', () => {
+  it('settles rejection and routes a shared node key only to its owning editor', async () => {
+    const first = reference('first')
+    const second = reference('second')
+    const firstRefresh = vi.fn(async () => ({ ...first, version: 'v2', digest: 'new', prompt: { ...first.prompt!, body: 'current source', originalBody: 'current source', source: { ...first.prompt!.source, version: 'v2', digest: 'new' } } }))
+    const secondRefresh = vi.fn(async () => ({ ...second, version: 'v2', digest: 'new' }))
+    const firstShell = shellFor(first, firstRefresh)
+    const secondShell = shellFor(second, secondRefresh)
+    const firstKey = keyOf(firstShell)
+    expect(secondShell.editor.dispatchCommand(REFRESH_REFERENCE_CHIP_COMMAND, { key: firstKey, resolve: vi.fn() })).toBe(false)
+    const received = vi.fn<(value: EditableReferenceRefreshOutcome) => void>()
+    expect(firstShell.editor.dispatchCommand(REFRESH_REFERENCE_CHIP_COMMAND, { key: firstKey, resolve: received })).toBe(true)
+    await vi.waitFor(() => expect(received).toHaveBeenCalledWith({
+      reference: expect.objectContaining({ id: 'first', version: 'v2' }),
+      guard: expect.objectContaining({ occurrenceId: firstKey, body: 'draft' }),
+    }))
+    expect(firstRefresh).toHaveBeenCalledOnce()
+    expect(secondRefresh).not.toHaveBeenCalled()
+
+    const rejected = vi.fn()
+    const rejectShell = shellFor(reference('rejected'), async () => { throw new Error('owner unavailable') })
+    expect(rejectShell.editor.dispatchCommand(REFRESH_REFERENCE_CHIP_COMMAND, { key: keyOf(rejectShell), resolve: rejected })).toBe(true)
+    await vi.waitFor(() => expect(rejected).toHaveBeenCalledWith({ reason: 'unavailable' }))
+    firstShell.dispose()
+    secondShell.dispose()
+    rejectShell.dispose()
+  })
+
+  it('invalidates an in-flight response and replacement when the occurrence body changes', async () => {
+    const source = reference('race')
+    let finish!: (value: StructuredReference) => void
+    const refreshed = new Promise<StructuredReference>(resolve => { finish = resolve })
+    const shell = shellFor(source, () => refreshed)
+    const key = keyOf(shell)
+    const received = vi.fn<(value: EditableReferenceRefreshOutcome) => void>()
+    expect(shell.editor.dispatchCommand(REFRESH_REFERENCE_CHIP_COMMAND, { key, resolve: received })).toBe(true)
+    expect(shell.editor.dispatchCommand(UPDATE_REFERENCE_CHIP_COMMAND, { key, body: 'edited during refresh' })).toBe(true)
+    finish({ ...source, version: 'v2', digest: 'new', prompt: { ...source.prompt!, body: 'current source', originalBody: 'current source', source: { ...source.prompt!.source, version: 'v2', digest: 'new' } } })
+    await vi.waitFor(() => expect(received).toHaveBeenCalledWith({ reason: 'stale' }))
+
+    const staleGuard = { occurrenceId: key, draftRevision: shell.snapshot.draftRev - 1, body: 'draft', proof: 'wrong' }
+    expect(shell.editor.dispatchCommand(UPDATE_REFERENCE_CHIP_COMMAND, {
+      key,
+      reference: { ...source, version: 'v2', digest: 'new' },
+      guard: staleGuard,
+    })).toBe(false)
+    const current = shell.editor.getEditorState().read(() => $nodesOfType(ReferenceChipNode)[0]!.getStructured())
+    expect(current?.prompt?.body).toBe('edited during refresh')
+    shell.dispose()
+  })
+})
