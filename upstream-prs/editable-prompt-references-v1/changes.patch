+/** Synthetic owner protocol tests; no filesystem, provider, or browser acceptance. */
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type { WorkspaceId } from '@deepseek-ai/dsh-workspace'
+import { SessionCommandController } from '../src/commands.ts'
+import type { ApiSessionAgentController } from '../src/agent.ts'
+import type { SessionPromptReference, SessionRequestId } from '../src/types.ts'
+
+const sessionId = 'grant-session-a' as SessionId
+const otherSessionId = 'grant-session-b' as SessionId
+const workspaceId = 'grant-workspace' as WorkspaceId
+const proof: SessionPromptReference = {
+  id: 'quote-a', owner: 'dsh.local', ref: 'opaque-a', kind: 'file', intent: 'content',
+  version: 'v1', digest: 'proof-v1', scope: 'file/full', window: { start: 0, end: 4 },
+}
+const signal = () => new AbortController().signal
+
+function bench(sensitive = false, initial: SessionPromptReference = proof) {
+  let current = initial
+  let allowed = true
+  const followup = vi.fn()
+  const ownerResolve = vi.fn(async ({ reference, authorization }: { reference: SessionPromptReference; authorization?: { revealToken: string } }) => {
+    if (!allowed || sensitive && authorization?.revealToken !== 'synthetic-reveal') return undefined
+    if (reference.ref !== current.ref || reference.version !== current.version || reference.digest !== current.digest
+      || JSON.stringify(reference.window) !== JSON.stringify(current.window)) return undefined
+    return { ...current, label: 'example.ts', snapshot: { type: 'text', text: 'body', truncated: false } }
+  })
+  const ownerRefresh = vi.fn(async ({ authorization }: { authorization?: { revealToken: string } }) => {
+    if (!allowed || sensitive && authorization?.revealToken !== 'synthetic-reveal') return undefined
+    return { ...current, label: 'example.ts', snapshot: { type: 'text', text: 'body', truncated: false } }
+  })
+  const workspace = { id: workspaceId, sessionIds: [sessionId, otherSessionId] }
+  const ctx = {
+    get: (name: string) => name === 'composerReferenceOwners' ? { version: 1, resolve: ownerResolve, refresh: ownerRefresh } : undefined,
+    workspaceRegistry: { get: (id: string) => id === workspaceId ? workspace : undefined, list: () => [workspace] },
+    llm: { listProviders: () => [{ id: 'synthetic-provider' }] },
+  } as unknown as Context
+  const agents = {
+    resolveAgent: async (id: SessionId) => ({ agent: { id, session: { header: {} }, followup } }),
+    selectionFor: () => ({ current: { provider: 'synthetic-provider', model: 'synthetic-model' } }),
+  } as unknown as ApiSessionAgentController
+  const controller = new SessionCommandController(ctx, agents, '')
+  const prepare = (authorization?: { revealToken: string }) => controller.prepareReference({
+    sessionId, workspaceId, reference: initial, ...(authorization ? { ownerAuthorization: authorization } : {}),
+  }, signal())
+  const send = (reference: SessionPromptReference, requestId = 'request-a', target = sessionId) => controller.prompt({
+    sessionId: target, requestId: requestId as SessionRequestId, mode: 'queue',
+    content: [{ type: 'text', text: 'edited body' }], references: [reference],
+  }, signal())
+  return { controller, prepare, send, ownerResolve, ownerRefresh, followup, workspace,
+    change: (next: SessionPromptReference) => { current = next }, revoke: () => { allowed = false } }
+}
