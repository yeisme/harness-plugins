+/** Additive projection for an owner-authorized editable prompt snapshot. */
+import type { EditablePromptReference, StructuredReference } from '../contract/input.ts'
+
+export function isEditablePromptReference(reference: StructuredReference): reference is StructuredReference & { readonly prompt: EditablePromptReference } {
+  if (typeof reference !== 'object' || reference === null || Array.isArray(reference)) return false
+  const prompt = reference.prompt
+  if (typeof prompt !== 'object' || prompt === null || Array.isArray(prompt)
+    || prompt.version !== 1 || typeof prompt.body !== 'string' || typeof prompt.originalBody !== 'string'
+    || (prompt.edited !== undefined && typeof prompt.edited !== 'boolean')) return false
+  const source = prompt.source
+  if (typeof source !== 'object' || source === null || Array.isArray(source)) return false
+  const fields = ['owner', 'ref', 'version', 'scope', 'digest'] as const
+  return fields.every(field => typeof source[field] === 'string'
+    && source[field].length > 0 && source[field] === reference[field])
+}
+
+/** The current draft body; source proof remains immutable. */
+export function editablePromptBody(reference: StructuredReference): string | undefined {
+  return isEditablePromptReference(reference) ? reference.prompt.body : undefined
+}
+
+/** Shared preview and model projection. It preserves all body whitespace verbatim. */
+export function projectEditablePromptReference(reference: StructuredReference): string | undefined {
+  if (!isEditablePromptReference(reference)) return undefined
+  const label = (reference.label ?? reference.ref).replace(/[\r\n]+/gu, ' ').trim() || 'reference'
+  return `### Reference: ${label}\n\n${reference.prompt.body}`
+}
+
+/** Compose the exact text that the default sink will hand to the session. */
+export function projectComposerDraft(
+  draft: string,
+  occurrences: readonly { readonly offset: number; readonly length: number; readonly clipboardText: string; readonly structured?: StructuredReference }[],
+): string {
+  let out = ''
+  let cursor = 0
+  for (const occurrence of occurrences) {
+    const text = occurrence.structured === undefined
+      ? occurrence.clipboardText
+      : projectEditablePromptReference(occurrence.structured) ?? occurrence.clipboardText
+    out += draft.slice(cursor, occurrence.offset) + text
+    cursor = occurrence.offset + occurrence.length
+  }
+  return out + draft.slice(cursor)
+}
+
+/** Change only the draft body of this instance, retaining its insertion proof. */
+export function withEditablePromptBody(reference: StructuredReference, body: string): StructuredReference {
+  if (!isEditablePromptReference(reference) || body === reference.prompt.body) return reference
+  return { ...reference, prompt: { ...reference.prompt, body, edited: body !== reference.prompt.originalBody } }
+}
