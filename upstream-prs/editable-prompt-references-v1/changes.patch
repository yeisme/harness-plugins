+import { describe, expect, it } from 'vitest'
+import type { StructuredReference } from '../src/client/contract/input.ts'
+import { isEditablePromptReference, projectEditablePromptReference, withEditablePromptBody } from '../src/client/input/editable-prompt-reference.ts'
+
+function reference(): StructuredReference {
+  return {
+    id: 'selection-one', owner: 'dsh.local', ref: 'opaque-one', kind: 'selection', intent: 'content',
+    version: 'version-one', scope: 'file/raw', digest: 'digest-one', label: 'sample.ts',
+    prompt: {
+      version: 1, body: '  editable\n\n', originalBody: 'original', edited: true,
+      source: { owner: 'dsh.local', ref: 'opaque-one', version: 'version-one', scope: 'file/raw', digest: 'digest-one' },
+    },
+  }
+}
+
+describe('editable prompt input validation', () => {
+  it('rejects malformed optional payloads without throwing or projecting their body', () => {
+    const valid = reference()
+    const malformed: unknown[] = [null, undefined, [], { ...valid, prompt: null }, { ...valid, prompt: [] },
+      { ...valid, prompt: { ...valid.prompt, source: null } },
+      { ...valid, prompt: { ...valid.prompt, source: undefined } },
+      { ...valid, prompt: { ...valid.prompt, source: [] } },
+      { ...valid, prompt: { ...valid.prompt, body: 7 } },
+      { ...valid, prompt: { ...valid.prompt, originalBody: null } },
+      { ...valid, prompt: { ...valid.prompt, edited: 'true' } },
+    ]
+    for (const value of malformed) {
+      expect(() => isEditablePromptReference(value as StructuredReference)).not.toThrow()
+      expect(isEditablePromptReference(value as StructuredReference)).toBe(false)
+      expect(projectEditablePromptReference(value as StructuredReference)).toBeUndefined()
+    }
+  })
+
+  it.each(['owner', 'ref', 'version', 'scope', 'digest'] as const)('rejects a mismatched %s instead of attaching unrelated provenance', field => {
+    const valid = reference()
+    const forged = { ...valid, prompt: { ...valid.prompt!, source: { ...valid.prompt!.source, [field]: 'different-proof' } } }
+    expect(isEditablePromptReference(forged)).toBe(false)
+    expect(projectEditablePromptReference(forged)).toBeUndefined()
+    expect(withEditablePromptBody(forged, 'replacement')).toBe(forged)
+  })
+
+  it('preserves valid editable whitespace and immutable source identity', () => {
+    const valid = reference()
+    expect(isEditablePromptReference(valid)).toBe(true)
+    expect(projectEditablePromptReference(valid)).toBe('### Reference: sample.ts\n\n  editable\n\n')
+    const changed = withEditablePromptBody(valid, '\tnew body\n')
+    expect(changed.prompt?.source).toBe(valid.prompt?.source)
+    expect(changed.prompt?.originalBody).toBe('original')
+    expect(changed.prompt?.body).toBe('\tnew body\n')
+  })
+})
