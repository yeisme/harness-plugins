+/** Merge every provider's bounded search terms into one lookup (per-session union in provider order). */
+export function mergedSearchTermsBySession(
+  snapshots: readonly SessionGroupingSnapshotV1Alpha1[],
+): Readonly<Record<string, readonly string[]>> | undefined {
+  if (snapshots.length === 0) return undefined
+  const merged: Record<string, readonly string[]> = {}
+  for (const snapshot of snapshots) {
+    const terms = snapshot.searchTermsBySession
+    if (terms === undefined) continue
+    for (const [sessionId, values] of Object.entries(terms)) {
+      const existing = merged[sessionId]
+      merged[sessionId] = existing === undefined ? [...values] : [...new Set([...existing, ...values])]
+    }
+  }
+  return Object.keys(merged).length === 0 ? undefined : merged
