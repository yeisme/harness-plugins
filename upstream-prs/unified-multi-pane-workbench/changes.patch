+function StructuredReferenceDock({ input, targetTitle, remove }: {
+  readonly input: InputZone['input']
+  readonly targetTitle: string | undefined
+  readonly remove: (referenceId: string) => boolean
+}) {
+  const references = [] as NonNullable<InputZone['input']['occurrences'][number]['structured']>[]
+  const seen = new Set<string>()
+  for (const occurrence of input.occurrences) {
+    if (occurrence.structured === undefined) continue
+    const identity = structuredIdentity(occurrence.structured)
+    if (seen.has(identity)) continue
+    seen.add(identity)
+    references.push(occurrence.structured)
+  }
+  if (references.length === 0) return null
+  return <details className={css.referenceDock} data-composer-reference-draft-v2>
+    <summary>{`References ${references.length} · Target: ${targetTitle ?? 'current conversation'}`}</summary>
+    <ul>
+      {references.map(reference => <li key={structuredIdentity(reference)} data-reference-kind={reference.kind}>
+        <details>
+          <summary>{reference.label ?? reference.ref}</summary>
+          <p>{reference.preview ?? `${reference.kind} · ${reference.intent}`}</p>
+        </details>
+        <button type="button" aria-label={`Remove ${reference.label ?? reference.ref} reference row`} onClick={() => { remove(reference.id) }}>Remove</button>
+      </li>)}
+    </ul>
+  </details>
+}
