+    expect(state.focused).toBe(start)
+    for (let i = 0; i < count * 3; i++) state = focusPane(state, cyclePane(state, -1)!)
+    expect(state.focused).toBe(start)
+    for (const mode of ['columns', 'rows', 'grid'] as const) {
+      const arranged = arrangePanes(state, mode)
+      expect(paneGroupOrder(arranged)).toEqual(ids)
+      expect(arranged.panes).toBe(state.panes)
+      expect(arranged.groups).toBe(state.groups)
