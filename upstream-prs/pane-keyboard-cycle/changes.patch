@@ -13,0 +15,39 @@ export function workbenchShortcut(event: KeyboardEvent): 'navigation' | 'single'
+export function panePrefixKey(event: KeyboardEvent): boolean {
+  return event.ctrlKey && !event.metaKey && !event.altKey && !event.shiftKey && (event.code === 'KeyB' || event.key.toLowerCase() === 'b')
+}
+export function panePrefixAction(event: KeyboardEvent): PaneShortcut | null {
+  if (event.ctrlKey || event.metaKey || event.altKey) return null
+  const key = event.code || event.key
+  if (key === 'KeyO' || event.key.toLowerCase() === 'o') return event.shiftKey ? 'previous' : 'next'
+  if (key === 'ArrowRight' || key === 'ArrowDown') return 'next'
+  if (key === 'ArrowLeft' || key === 'ArrowUp') return 'previous'
+  if (key === 'Space' || event.key === ' ') return 'cycle'
+  if (event.key === '%' || key === 'Digit5' && event.shiftKey) return 'split-right'
+  if (event.key === '"' || key === 'Quote' && event.shiftKey) return 'split-bottom'
+  if (key === 'KeyZ' || event.key === 'z') return 'single'
+  if (key === 'KeyB' || event.key === 'b') return 'navigation'
+  return null
+}
+export function paneGroupOrder(state: WorkspaceSnapshot): string[] {
+  const visit = (node: LayoutNode | null): string[] => node === null ? [] : node.type === 'group' ? [node.id] : [...visit(node.first), ...visit(node.second)]
+  return [...visit(state.root), ...state.floating.map(f => f.groupId)].filter(id => state.groups[id]?.active)
+}
+export function cyclePane(state: WorkspaceSnapshot, direction: 1 | -1): string | null {
+  const ids = paneGroupOrder(state)
+  if (!ids.length) return null
+  const index = ids.indexOf(state.focused ?? '')
+  const next = index < 0 ? direction === 1 ? 0 : ids.length - 1 : (index + direction + ids.length) % ids.length
+  return state.groups[ids[next]!]!.active
+}
+/** Reflow every docked group without replacing pane identities, tabs or bindings. */
+export function arrangePanes(state: WorkspaceSnapshot, mode: 'columns' | 'rows' | 'grid'): WorkspaceSnapshot {
+  const ids = paneGroupOrder(state).filter(id => !state.floating.some(f => f.groupId === id))
+  if (!ids.length) return state
+  let serial = 0
+  const build = (groups: string[], depth: number): LayoutNode => {
+    if (groups.length === 1) return { type: 'group', id: groups[0]! }
+    const middle = Math.ceil(groups.length / 2)
+    return { type: 'split', id: `reflow:${serial++}`, axis: mode === 'rows' || mode === 'grid' && depth % 2 === 1 ? 'vertical' : 'horizontal', ratio: middle / groups.length, first: build(groups.slice(0, middle), depth + 1), second: build(groups.slice(middle), depth + 1) }
+  }
+  return { ...state, maximized: null, root: build(ids, 0) }
+}
