   visibility: hidden;
   pointer-events: none;
 }
+
+/* A maximized Pane keeps the native conversation composer usable at the page
+ * bottom. The ConversationRoot stays mounted, but only its composer seat is
+ * raised above the Pane; transcript/header chrome remains hidden. */
+.frame[data-workspace-composer='bottom-overlay'] .centerCol {
+  pointer-events: none;
+  z-index: 11;
+}
+
+.frame[data-workspace-composer='bottom-overlay'] .centerCol :global([data-composer-seat]) {
+  visibility: visible;
+  pointer-events: auto;
+}
+
+/* Blank/new-session ConversationRoots normally center the full hero stack.
+ * Under a maximized Pane only the native input card is useful, so keep the
+ * seat at the bottom and suppress the hero headline/glow without remounting
+ * the draft-bearing composer tree. */
+.frame[data-workspace-composer='bottom-overlay'] .centerCol :global([data-phase='hero']) :global([data-conversation-scroll]) {
+  justify-content: flex-end;
+}
+
+.frame[data-workspace-composer='bottom-overlay'] .centerCol :global([data-phase='hero']) :global([data-composer-seat]) > * {
+  visibility: hidden;
+}
+
+.frame[data-workspace-composer='bottom-overlay'] .centerCol :global([data-phase='hero']) :global([data-composer-card]) {
+  visibility: visible;
+}
 
