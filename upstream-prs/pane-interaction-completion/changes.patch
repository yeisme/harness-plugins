@@ -82,0 +84,24 @@ export function Workbench(props: Props) {
+  function applyLayout(mode: 'single' | 'columns' | 'rows') {
+    const { live: layout, actions: currentActions } = ref.current
+    if (mode === 'single') {
+      if (layout.focused) currentActions.maximize(layout.focused)
+      return
+    }
+    if (layout.root?.type === 'split') {
+      currentActions.commitGeometry({ ...layout, maximized: null, root: { ...layout.root, axis: mode === 'columns' ? 'horizontal' : 'vertical', ratio: 0.5 } })
+    } else if (layout.root?.type === 'group') {
+      const group = layout.groups[layout.root.id]!
+      if (group.panes.length > 1) currentActions.movePane(group.panes.at(-1)!, { type: 'split', groupId: group.id, edge: mode === 'columns' ? 'right' : 'bottom' })
+    }
+  }
+  useEffect(() => {
+    const handle = (event: KeyboardEvent) => {
+      const action = workbenchShortcut(event)
+      if (action === null || action === 'navigation') return
+      event.preventDefault()
+      if (action === 'menu') setLayouts(value => !value)
+      else applyLayout(action)
+    }
+    document.addEventListener('keydown', handle)
+    return () => document.removeEventListener('keydown', handle)
+  }, [])
