+      <button aria-keyshortcuts="Control+Alt+2 Meta+Alt+2" disabled={!live.root || live.root.type === 'group' && live.groups[live.root.id]!.panes.length < 2} onClick={() => { applyLayout('columns'); setLayouts(false) }}>{t('wb.columnsLayout')} · Ctrl+Alt+2</button>
+      <button aria-keyshortcuts="Control+Alt+3 Meta+Alt+3" disabled={!live.root || live.root.type === 'group' && live.groups[live.root.id]!.panes.length < 2} onClick={() => { applyLayout('rows'); setLayouts(false) }}>{t('wb.rowsLayout')} · Ctrl+Alt+3</button>
